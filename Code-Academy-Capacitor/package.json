{
  "name": "code-academy-capacitor",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor Android wrapper for the Code Academy web application",
  "scripts": {
    "build:native": "vite build --config vite.native.config.mjs",
    "build:push": "vite build --config vite.push.config.mjs",
    "cap:sync": "cap sync android",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "android:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/device": "^8.0.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "typescript": "5.9.3",
    "vite": "^8.3.5"
  },
  "type": "module"
}
