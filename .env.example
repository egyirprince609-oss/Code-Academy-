# Example only. Set real secrets in Render Dashboard > Environment. Do NOT commit a real .env file.
APP_ENV=production
ALLOWED_ORIGINS=https://egyirprince609-oss.github.io
# A working SearXNG service URL is required for SearXNG-based search.
SEARXNG_URL=http://127.0.0.1:8080
# Optional provider API keys: configure as Render environment variables, never in browser.html.
BRAVE_SEARCH_API_KEY=
WEBRISK_API_KEY=
# Set a long random secret before enabling admin endpoints.
ADMIN_TOKEN=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
# If deployed separately, configure private service DNS/address and port.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=25
MAX_UPLOAD_MB=15
ALLOW_EXECUTABLE_DOWNLOADS=false
DATABASE_PATH=/data/academy-browser.sqlite3
QUARANTINE_DIR=/quarantine
QUARANTINE_RETENTION_HOURS=24
SEARCH_TIMEOUT_SECONDS=5
URL_CHECK_TIMEOUT_SECONDS=4
RATE_SEARCH_PER_MINUTE=30
RATE_URL_CHECK_PER_MINUTE=60
TRUST_PROXY_HEADERS=false
