# Set these variables on your secure Python hosting dashboard.
# Do not commit a real .env file, service-account JSON, API key, or access token.

PORT=8000
LOG_LEVEL=INFO
FIREBASE_PROJECT_ID=codeacademybywm
# Option A: configure a secret JSON value in your host (never in browser code):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Option B: set GOOGLE_APPLICATION_CREDENTIALS to a private key file path on the server.

# Origin of the static website; comma-separate more trusted origins if needed.
FRONTEND_ORIGINS=https://egyirprince609-oss.github.io,http://localhost:5500,http://127.0.0.1:5500
API_RATE_LIMIT=120 per hour
RATE_LIMIT_STORAGE_URL=memory://

# Safe initial mode: manual wallet transfer + owner verification.
PAYMENT_MODE=manual_momo
MOMO_RECIPIENT_PHONE=233593675745
MOMO_RECIPIENT_NAME=Constance Mensah

# To enable automatic MTN request-to-pay, first obtain an approved MTN Collections merchant setup.
# Never put these values in premium.html or premium.js.
# PAYMENT_MODE=mtn_momo
# MTN_TARGET_ENVIRONMENT=mtnghana
# MTN_API_BASE_URL=https://proxy.momoapi.mtn.com
# MTN_COLLECTION_API_USER=YOUR_SERVER_SIDE_API_USER_UUID
# MTN_COLLECTION_API_KEY=YOUR_SERVER_SIDE_API_KEY
# MTN_COLLECTION_SUBSCRIPTION_KEY=YOUR_COLLECTION_SUBSCRIPTION_KEY
# For sandbox only, use MTN_TARGET_ENVIRONMENT=sandbox and MTN_API_BASE_URL=https://sandbox.momodeveloper.mtn.com

# Comma-separated Firebase Auth UIDs allowed to manually approve payment records.
ADMIN_UIDS=REPLACE_WITH_AUTHORIZED_REVIEWER_FIREBASE_UID

# Optional automated owner alerts: WhatsApp Business Platform Cloud API only.
# Use an approved WhatsApp message template with 8 body placeholders: {{1}} through {{8}}.
# OWNER_WHATSAPP is international digits only; phone number ID is supplied by Meta.
OWNER_WHATSAPP=233XXXXXXXXX
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_LANGUAGE_CODE=en
