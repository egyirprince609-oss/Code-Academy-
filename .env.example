# Example only. Never store real tokens in this file or commit a real .env.
# Required for browser map tiles: Mapbox public token beginning with pk.
MAPBOX_PUBLIC_TOKEN=pk.replace_with_your_public_token

# Optional: server-only Mapbox secret token beginning with sk.
# Used only by server.js for geocoding requests. NEVER put it in HTML/JS.
MAPBOX_SECRET_TOKEN=sk.replace_with_your_server_secret_token

# Site origin without a trailing slash. Add other known domains comma-separated if needed.
ALLOWED_ORIGINS=https://egyirprince609-oss.github.io
