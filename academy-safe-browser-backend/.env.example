# Copy this file to .env and replace every CHANGE_ME value before deployment.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# Used by SearXNG to sign sessions. Must be a long random secret.
SEARXNG_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
# Optional upstream search API; stored only on the backend.
BRAVE_SEARCH_API_KEY=
# Google Cloud Web Risk Lookup API key. Create/enable Web Risk in Google Cloud.
WEBRISK_API_KEY=

# Admin token protects blocklist and quarantine review endpoints.
ADMIN_TOKEN=CHANGE_ME_GENERATE_ANOTHER_LONG_RANDOM_SECRET
# Browser frontend origin(s), comma-separated. No trailing slash.
ALLOWED_ORIGINS=https://egyirprince609-oss.github.io,http://localhost:5500,http://127.0.0.1:5500

# Operational settings
SEARCH_TIMEOUT_SECONDS=5
URL_CHECK_TIMEOUT_SECONDS=4
MAX_UPLOAD_MB=15
ALLOW_EXECUTABLE_DOWNLOADS=false
DATABASE_PATH=/data/academy-browser.sqlite3
QUARANTINE_DIR=/quarantine
QUARANTINE_RETENTION_HOURS=24
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=25
RATE_SEARCH_PER_MINUTE=30
RATE_URL_CHECK_PER_MINUTE=60

# Optional: set if a reverse proxy overwrites X-Forwarded-For and you understand
# your deployment. Otherwise rate limiting uses the direct peer address.
TRUST_PROXY_HEADERS=false
